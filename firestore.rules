rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    function temPerfil() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function liberado() {
      return temPerfil() && perfil().aprovado == true;
    }
    function admin() {
      return liberado() && perfil().papel == 'admin';
    }

    // ---------- USUÁRIOS ----------
    match /usuarios/{uid} {
      // cada um lê o próprio perfil; quem já foi liberado lê os demais
      allow get: if logado() && (request.auth.uid == uid || liberado());
      allow list: if admin();

      // ao criar a conta, a pessoa entra bloqueada e como caixa - não dá para se autopromover
      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.aprovado == false
                    && request.resource.data.papel == 'caixa';

      // o próprio usuário só pode mudar o nome; liberação e papel são do admin
      allow update: if admin()
                    || (request.auth.uid == uid
                        && request.resource.data.aprovado == resource.data.aprovado
                        && request.resource.data.papel == resource.data.papel);

      allow delete: if admin();
    }

    // ---------- PRODUTOS ----------
    match /produtos/{id} {
      allow read: if liberado();
      allow write: if admin();
    }

    // ---------- VENDAS ----------
    match /vendas/{id} {
      allow read: if liberado();
      allow create: if liberado()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.cancelada == false
                    && request.resource.data.total is int
                    && request.resource.data.total >= 0;
      // venda registrada não se apaga nem se edita: só o admin pode cancelar
      allow update: if admin();
      allow delete: if false;
    }

    // ---------- CONFIGURAÇÃO DA LOJA ----------
    match /config/{id} {
      allow read: if liberado();
      allow write: if admin();
    }
  }
}
